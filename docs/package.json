{
	"name": "pg-automerge-docs",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && NODE_ENV=production ./ssg.tsx && node scripts/copy-404.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings",
