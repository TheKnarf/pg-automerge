             "parents": [                        +
             ]                                   +
         }                                       +
     },                                          +
     {                                           +
         "type": "text",                         +
         "value": "Shopping tips"                +
     },                                          +
     {                                           +
         "type": "block",                        +
         "value": {                              +
             "type": "paragraph",                +
             "attrs": {                          +
             },                                  +
             "parents": [                        +
             ]                                   +
         }                                       +
     },                                          +
     {                                           +
         "type": "text",                         +
